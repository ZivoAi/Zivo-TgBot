TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

ZIVOPAL_API_URL=https://api.zivopal.com
ZIVOPAL_CLIENT_ID=your_client_id
ZIVOPAL_CLIENT_SECRET=your_client_secret_here
ZIVOPAL_SERVICE_NAME=zivopal-classroom-bot

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

MODERATION_ENABLED=true
MODERATION_CONFIDENCE_THRESHOLD=0.7

SENTRY_DSN=
SENTRY_ENABLED=false

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,sn
